        <mxCell id="p5_title" value="หน้า 5 การทำแบบฝึกและสอบ" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p5_legend" value="ปลายเส้น:  ‖ สองขีด = ต้องมี 1  ·  ○| วงกลม+ขีด = 0 หรือ 1  ·  ○&lt; วงกลม+สามแฉก = 0 ถึงหลาย  ·  สัญลักษณ์ติดกล่องไหน = จำนวนของกล่องนั้น  |  ตัวหนา = คีย์หลัก · ตัวเอียง = ช่องที่ชี้ไปตารางอื่น · หนา+เอียง = คีย์หลักที่ชี้ไปตารางอื่นด้วย · กล่องเส้นประ = ตารางจากหน้าอื่น" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5_users" value="ผู้ใช้" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="132" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p5_users__0" value="รหัสผู้ใช้" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="p5_users">
