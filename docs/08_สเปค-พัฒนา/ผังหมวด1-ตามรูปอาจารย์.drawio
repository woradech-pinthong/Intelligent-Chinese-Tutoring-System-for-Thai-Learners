        <mxCell id="m_write" value="เขียน&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;ไม่สอบ&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="605" y="112" width="62" height="36" as="geometry"/></mxCell>
        <mxCell id="count" value="&lt;b&gt;นับยังไง&lt;/b&gt;&lt;br&gt;คน = มิ้นท์ · หมวด = 1 · ข้อฟัง&lt;br&gt;นับ is_correct = 1&lt;br&gt;→ ถูก 2 จาก 3 ข้อ&lt;br&gt;(ดู attempts จับคู่ sessions)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1270" y="600" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="skills_note" value="ไม่ใช่ตารางแยก — เป็นค่าในช่อง items.module / attempts.generator · HSK 1 สอบแค่ ฟัง + อ่าน" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="390" y="158" width="282" height="52" as="geometry"/></mxCell>
        <mxCell id="items_note" value="ข้อละ 1 เสียง + เฉลย 1 (ตัวล็อก) + ตัวลวง 3 จากหมวดเดียวกัน ไม่ซ้ำ · ทุกข้อติดป้ายทักษะใน item_skills (SKILL-LISTEN + VOCAB-C1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="980" y="268" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="skill_note" value="ชั้นทักษะที่ 2: 4 ด้านของอาจารย์ (ฟัง/อ่าน) = ค่าในช่อง · ตาราง skills = หน่วยย่อยที่โมเดลวัด · ข้อสอบชี้ว่าวัดหน่วยไหนผ่าน item_skills (1 ข้อหลายป้ายได้) · ทุกคำตอบใน attempts ก๊อปป้ายมาใส่ skill_id → โมเดล BKT นับถูก/ผิดแยกตามป้าย = ความแม่นรายหน่วย (mastery_snapshots)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="1460" height="30" as="geometry"/></mxCell>
        <mxCell id="prog_note" value="หลอด = words_learned ÷ categories.word_count (70) · แถวนี้เกิดตอนมิ้นท์เปิดหมวด 1 ครั้งแรก" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="140" y="476" width="260" height="44" as="geometry"/></mxCell>
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27;&gt;ผังหมวด 1 ฉบับทีม — เดินตามรูปที่อาจารย์วาด (นัดรอบ 7 · 1 ต.ค. 69) · ชื่อตาราง/ช่อง/ค่า = ของจริงใน Supabase&lt;/font&gt;&lt;/b&gt;&lt;br&gt;หมวด → ทักษะ → คำ+เสียง → ข้อสอบ → ผลรายคน → นับ · สีเหลือง = แถวของมิ้นท์ (ผู้เรียนสาธิต) · บนลูกศร = ช่องที่ใช้โยง · เลขแดง = ลำดับที่กดในเว็บ (0 สมัคร · ① เลือกหมวด · ② หน้าหมวด/ทักษะ · ③ บัตรคำ · ④ ควิซ · ⑤ ผล)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1600" height="50" as="geometry"/></mxCell>
